QWidget {
    color: #E7EDF0;
    background-color: #161A1D;
    selection-background-color: #2FA6A1;
    selection-color: #F4FAFA;
    font-family: "Segoe UI", "Inter", "Arial", sans-serif;
    font-size: 10pt;
}

QMainWindow,
QDialog {
    background-color: #161A1D;
}

QMenuBar {
    background-color: #20262B;
    color: #C9D4D9;
    border-bottom: 1px solid #344149;
    padding: 2px 8px;
}

QMenuBar::item {
    background: transparent;
    border-radius: 6px;
    padding: 6px 12px;
}

QMenuBar::item:selected {
    background-color: #252D33;
    color: #F4FAFA;
}

QMenu {
    background-color: #20262B;
    color: #E7EDF0;
    border: 1px solid #344149;
    padding: 6px;
}

QMenu::separator {
    height: 1px;
    background-color: #344149;
    margin: 6px 4px;
}

QMenu::item {
    border-radius: 6px;
    padding: 7px 28px 7px 12px;
}

QMenu::item:selected {
    background-color: #263C40;
    color: #F4FAFA;
}

QLabel {
    color: #C9D4D9;
    background-color: transparent;
    font-size: 10pt;
}

QLabel#footerLabel {
    color: #9BA8AF;
    border-top: 1px solid #344149;
    padding-top: 8px;
    margin-top: 0px;
    font-size: 9pt;
}

QLabel#footerLabel:hover {
    color: #C9D4D9;
}

QWidget#actionsBar {
    background-color: #161A1D;
    border-top: 1px solid #344149;
    border-bottom: 1px solid #344149;
}

QGroupBox {
    background-color: #20262B;
    color: #F4FAFA;
    border: 1px solid #344149;
    border-radius: 8px;
    font-size: 11pt;
    font-weight: 600;
    margin-top: 14px;
    padding: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #CFEAE8;
}

QPushButton,
QToolButton {
    min-height: 34px;
    border-radius: 8px;
    padding: 7px 12px;
    font-size: 10pt;
    font-weight: 600;
}

QPushButton[role="secondary"],
QPushButton {
    background-color: #252D33;
    color: #E7EDF0;
    border: 1px solid #3B4A52;
}

QPushButton[role="secondary"]:hover,
QPushButton:hover {
    background-color: #2B353C;
    border-color: #4A5B64;
}

QPushButton[role="secondary"]:pressed,
QPushButton:pressed {
    background-color: #20262B;
    border-color: #2FA6A1;
}

QPushButton[role="tertiary"] {
    background-color: transparent;
    color: #C9D4D9;
    border: 1px solid #344149;
}

QPushButton[role="tertiary"]:hover {
    background-color: #20262B;
    color: #F4FAFA;
    border-color: #4A5B64;
}

QPushButton[role="tertiary"]:pressed {
    background-color: #252D33;
    border-color: #2FA6A1;
}

QPushButton[role="primary"] {
    background-color: #2FA6A1;
    color: #F4FAFA;
    border: 1px solid #43BCB7;
}

QPushButton[role="primary"]:hover {
    background-color: #35B4AE;
    border-color: #5FCAC6;
}

QPushButton[role="primary"]:pressed {
    background-color: #238E8A;
    border-color: #2FA6A1;
}

QPushButton:disabled,
QPushButton[role="primary"]:disabled,
QPushButton[role="secondary"]:disabled,
QPushButton[role="tertiary"]:disabled {
    background-color: #1B2024;
    color: #6F7C83;
    border-color: #2A3339;
}

QLineEdit,
QComboBox,
QDateEdit,
QListWidget,
QPlainTextEdit,
QTableWidget {
    background-color: #252D33;
    color: #E7EDF0;
    border: 1px solid #344149;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: #2FA6A1;
    selection-color: #F4FAFA;
}

QLineEdit {
    placeholder-text-color: #9BA8AF;
}

QLineEdit:hover,
QComboBox:hover,
QDateEdit:hover,
QPlainTextEdit:hover {
    border-color: #4A5B64;
    background-color: #29333A;
}

QLineEdit:focus,
QComboBox:focus,
QDateEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #2FA6A1;
    background-color: #252D33;
}

QLineEdit:read-only {
    color: #C9D4D9;
}

QComboBox,
QDateEdit {
    padding-right: 30px;
}

QComboBox#modeCombo {
    padding-left: 10px;
    padding-right: 24px;
}

QComboBox#dateFilterCombo {
    padding-left: 10px;
    padding-right: 24px;
}

QComboBox::drop-down,
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border: none;
    border-left: 1px solid #344149;
    background-color: transparent;
}

QComboBox#modeCombo::drop-down {
    width: 24px;
}

QComboBox#dateFilterCombo::drop-down {
    width: 24px;
}

QComboBox::down-arrow,
QDateEdit::down-arrow {
    image: url(app/resources/icons/chevron-down.svg);
    width: 12px;
    height: 12px;
}

QPushButton#fieldAddButton {
    min-height: 0px;
    min-width: 0px;
    padding: 0px;
    background-color: #263C40;
    color: #CFEAE8;
    border: 1px solid #3B5B5D;
    border-radius: 8px;
    font-size: 12pt;
    font-weight: 700;
}

QPushButton#fieldAddButton:hover {
    background-color: #2E4A4D;
    border-color: #2FA6A1;
    color: #F4FAFA;
}

QPushButton#fieldAddButton:pressed {
    background-color: #238E8A;
    border-color: #43BCB7;
}

QToolButton#fieldDropdownButton {
    min-height: 0px;
    min-width: 0px;
    padding: 0px;
    background-color: #263C40;
    color: #CFEAE8;
    border: 1px solid #3B5B5D;
    border-radius: 16px;
    font-size: 10pt;
    font-weight: 700;
}

QToolButton#fieldDropdownButton:hover {
    background-color: #2E4A4D;
    border-color: #2FA6A1;
    color: #F4FAFA;
}

QToolButton#fieldDropdownButton:pressed {
    background-color: #238E8A;
    border-color: #43BCB7;
}

QComboBox QAbstractItemView,
QCompleter QAbstractItemView {
    background-color: #20262B;
    color: #E7EDF0;
    border: 1px solid #344149;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: #263C40;
    selection-color: #F4FAFA;
    outline: 0;
}

QCheckBox {
    color: #C9D4D9;
    spacing: 8px;
    background-color: transparent;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #4A5B64;
    background-color: #252D33;
}

QCheckBox::indicator:hover {
    border-color: #2FA6A1;
    background-color: #29333A;
}

QCheckBox::indicator:checked {
    background-color: #2FA6A1;
    border-color: #43BCB7;
    image: url(app/resources/icons/check.svg);
}

QPlainTextEdit {
    background-color: #20262B;
}

QTableWidget {
    gridline-color: #344149;
    background-color: #20262B;
    alternate-background-color: #242B31;
    border: 1px solid #344149;
    border-radius: 8px;
    padding: 0px;
    font-size: 9pt;
}

QHeaderView::section {
    background-color: #252D33;
    color: #F4FAFA;
    padding: 8px;
    border: none;
    border-right: 1px solid #344149;
    border-bottom: 1px solid #344149;
    font-size: 9pt;
    font-weight: 700;
}

QTableWidget::item {
    padding: 6px;
    border-bottom: 1px solid #344149;
    border-right: 1px solid #344149;
}

QTableWidget::item:hover {
    background-color: #2B353C;
    color: #F4FAFA;
}

QTableWidget::item:selected {
    background-color: #263C40;
    color: #F4FAFA;
}

QListWidget::item {
    padding: 8px;
    border-bottom: 1px solid #344149;
}

QListWidget::item:hover {
    background-color: #2B353C;
}

QListWidget::item:selected {
    background-color: #263C40;
    color: #F4FAFA;
}

QTabWidget::pane {
    border: 1px solid #344149;
    border-radius: 8px;
    padding: 8px;
}

QTabBar::tab {
    background-color: #20262B;
    color: #C9D4D9;
    border: 1px solid #344149;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 14px;
    margin-right: 4px;
}

QTabBar::tab:hover {
    background-color: #252D33;
}

QTabBar::tab:selected {
    background-color: #263C40;
    color: #F4FAFA;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background: #161A1D;
    border: none;
    width: 10px;
    height: 10px;
}

QScrollBar::handle {
    background: #344149;
    border-radius: 5px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:hover {
    background: #4A5B64;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    height: 0px;
    width: 0px;
}
